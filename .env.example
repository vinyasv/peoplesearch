EXA_API_KEY=
# ANTHROPIC_API_KEY=   (or use `ant auth login`)

# Optional overrides
# PR_PLANNER_MODEL=claude-opus-5-5
# PR_VERIFIER_MODEL=claude-haiku-5-5
# PR_VERIFIER_EFFORT=medium
# PR_CANDIDATES=10
# PR_MAX_AGENT_TURNS=8
# PR_LLM_CONCURRENCY=8
# PR_EXA_CONCURRENCY=5
# PR_FALLBACKS=1
# PR_ENRICH_EMAILS=qualified   # qualified | all | off
# PR_ENRICH_BUDGET=2           # max dollars per email lookup run

# API server (for the web/ frontend)
# HOST=127.0.0.1               # 0.0.0.0 when deployed
# PR_CORS_ORIGINS=http://localhost:3000
# PR_CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app
